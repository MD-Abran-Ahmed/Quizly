# Quizly Environment Configuration

# Flask Secret Key for Session Encryption
SECRET_KEY=quizly_apple_liquid_glass_secret_key_8f293b4a1c6e

# Flask Environment Mode
FLASK_DEBUG=True
PORT=5000

# Database Configuration (SQLite default, can be switched to PostgreSQL)
DATABASE_URI=sqlite:///quizly.db

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upload Settings
MAX_CONTENT_LENGTH=26214400
